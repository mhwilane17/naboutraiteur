# Configuration de la base de données avec pool de connexions optimisé
# Pour éviter l'erreur "Too many database connections"
DATABASE_URL="postgresql://username:password@localhost:5432/nabou_traiteur?connection_limit=5&pool_timeout=20&connect_timeout=60"

# Configuration Resend pour l'envoi d'emails
RESEND_API_KEY="re_your_resend_api_key_here"
FROM_EMAIL="noreply@yourdomain.com"

# Configuration WhatsApp (optionnel)
WHATSAPP_TOKEN="your_whatsapp_token"
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id"
WHATSAPP_RECIPIENT_PHONE_NUMBER="221xxxxxxxxx"

# Configuration Wave Payment (optionnel)
WAVE_PAYMENT_LINK="https://your-wave-payment-link"

# Autres configurations
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"